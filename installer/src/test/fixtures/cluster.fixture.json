{
  "k3s": {
    "token": "not-a-real-token-this-is-a-fixture",
    "kubeconfig": "/etc/rancher/k3s/k3s.yaml"
  },
  "values": {
    "adminEmail": "someone@example.test",
    "domain": {
      "main": "example.test",
      "auth": "auth.example.test",
      "agent": "agent.example.test",
      "crm": "crm.example.test",
      "mattermost": "chat.example.test",
      "invoicing": "invoice.example.test",
      "signing": "sign.example.test"
    },
    "authentik": {
      "secretKey": "not-a-real-signing-key-this-is-a-fixture"
    }
  },
  "smtp": {
    "host": "smtp.example.test",
    "port": 587,
    "security": "starttls",
    "username": "fixture-mailer",
    "password": "not-a-real-password-this-is-a-fixture"
  },
  "dns": {
    "target": "203.0.113.10",
    "providers": [
      {
        "name": "office",
        "provider": "cloudflare",
        "domains": ["example.test"],
        "excludeDomains": ["clients.example.test"],
        "namespaces": ["cc-office"],
        "credentials": { "CF_API_TOKEN": "not-a-real-token-this-is-a-fixture" }
      },
      {
        "name": "acme",
        "provider": "aws",
        "domains": ["acme.clients.example.test"],
        "namespaces": ["client-acme"],
        "credentials": {
          "AWS_ACCESS_KEY_ID": "not-a-real-key-id",
          "AWS_SECRET_ACCESS_KEY": "not-a-real-secret-key"
        },
        "args": ["--aws-zone-type=public"]
      }
    ]
  },
  "network": {
    "congestionControl": "bbr",
    "cilium": {
      "kubeProxyReplacement": true
    },
    "gateway": {
      "mode": "port-forward",
      "addresses": ["192.0.2.240-192.0.2.250"]
    }
  },
  "packages": {
    "cert-manager": true,
    "cloudnative-pg": true
  },
  "storage": {
    "minimumSizeGb": 1
  },
  "nodes": [
    {
      "name": "server-1",
      "address": "server-1.test",
      "username": "someone",
      "type": "server",
      "gateway": true,
      "roles": ["worker", "storage-local"],
      "region": "mob",
      "zone": "mob-mob-0"
    },
    {
      "name": "agent-1",
      "address": "agent-1.test",
      "username": "someone",
      "type": "agent",
      "gateway": false,
      "roles": ["worker", "storage-local"],
      "region": "mob",
      "zone": "mob-mob-1"
    }
  ]
}
